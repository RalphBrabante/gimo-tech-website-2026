# Gimo Tech Supplies — static website (Next.js export) on Hostinger / LiteSpeed / Apache.
# Keep the redirect and header rules in sync with /server.js (Node fallback server).

Options -Indexes -MultiViews
DirectoryIndex index.html
DirectorySlash Off
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonical host: no www. (HTTP→HTTPS is already enforced at Hostinger's edge; a second
  # HTTPS rule here could loop when the CDN reaches the origin over HTTP.)
  RewriteCond %{HTTP_HOST} ^www\.gimosupplies\.com$ [NC]
  RewriteRule ^ https://gimosupplies.com%{REQUEST_URI} [R=301,L]

  # Legacy nylon product aliases (one-hop 301s).
  RewriteRule ^product/nylon-syringe-filter-25mm-045um/?$ /products/nylon-syringe-filter-25mm-045um [R=301,L]
  RewriteRule ^products/nylon-syringe-filter-25mm-0-45um/?$ /products/nylon-syringe-filter-25mm-045um [R=301,L]
  RewriteRule ^products/nylon-syringe-filter-25mm-045-micron/?$ /products/nylon-syringe-filter-25mm-045um [R=301,L]

  # Retired backend URLs: the admin dashboard and API are no longer served.
  RewriteRule ^(api|internal|uploads|dashboard)(/.*)?$ - [R=404,L]
  # Direct requests for the raw index/404 files are not pages (the ErrorDocument lookup is an
  # internal redirect and must still reach /404.html).
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteRule ^(index|404)\.html$ - [R=404,L]


  # Trailing-slash variants redirect to the canonical URL.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Build folders without a page of their own (e.g. /guides) are 404s, not directory listings.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}.html !-f
  RewriteRule ^(.+?)/?$ - [R=404,L]

  # Markdown for AI agents: "Accept: text/markdown" gets the page's .md copy (built by
  # client/scripts/build-markdown.mjs). Browsers keep receiving HTML.
  RewriteCond %{HTTP:Accept} text/markdown [NC]
  RewriteRule ^$ index.md [L]
  RewriteCond %{HTTP:Accept} text/markdown [NC]
  RewriteCond %{REQUEST_FILENAME}.md -f
  RewriteRule ^(.+)$ $1.md [L]

  # Clean URLs: /contact-us -> contact-us.html
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.googleadservices.com https://googleads.g.doubleclick.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://www.googletagmanager.com https://*.google-analytics.com https://googleads.g.doubleclick.net https://www.google.com https://www.google.com.ph; font-src 'self'; connect-src 'self' https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://*.google.com https://googleads.g.doubleclick.net https://www.googleadservices.com; frame-src 'self' https://www.google.com https://maps.google.com https://td.doubleclick.net; worker-src 'self' blob:; base-uri 'self'; form-action 'self' mailto:; frame-ancestors 'self'; object-src 'none'"

  # Scripts, styles, fonts and images for a week (build files are content-hashed, so a new
  # deployment never serves stale code); pages revalidate after 5 minutes.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
  </FilesMatch>
  <FilesMatch "\.(avif|webp|jpg|jpeg|png|svg|ico)$">
    Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
  </FilesMatch>
  <FilesMatch "\.(xml|txt)$">
    Header set Cache-Control "public, max-age=300, stale-while-revalidate=86400"
  </FilesMatch>
  # Pages: same URL can be HTML or Markdown, so responses vary by Accept; the Link header points
  # agents at llms.txt (RFC 8288).
  # no-transform: stops the CDN (Cloudflare, via Hostinger) rewriting pages: it would otherwise
  # inject a parser-blocking email-decode script and a beacon script that the CSP blocks.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=300, stale-while-revalidate=86400, no-transform"
    Header merge Vary "Accept"
    Header set Link "</llms.txt>; rel=\"describedby\"; type=\"text/plain\""
  </FilesMatch>
  # Negotiated Markdown must never be stored by a shared cache under the HTML URL.
  <FilesMatch "\.md$">
    Header set Cache-Control "private, max-age=300"
    Header merge Vary "Accept"
    Header set Link "</llms.txt>; rel=\"describedby\"; type=\"text/plain\""
  </FilesMatch>
</IfModule>

# no-transform also stops the CDN compressing pages itself, so compress them here.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript text/plain text/markdown application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 5 minutes"
</IfModule>

<IfModule mod_mime.c>
  AddType "text/markdown; charset=utf-8" .md
  AddType "text/plain; charset=utf-8" .txt
  AddType image/avif .avif
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>
